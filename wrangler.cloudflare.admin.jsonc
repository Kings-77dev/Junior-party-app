{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mcvyral-reserve-admin-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_SURFACE": "organizer",
    "ADMIN_ENABLED": "false"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "midnight-reserve-uploads-staging"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "midnight-reserve-staging",
      "database_id": "22fea444-0e42-49d0-81bd-2037263d5b05",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
